% %--------------------------------------------------------------
% % Block environment
% %-------------------------------------------------------------
\defbeamertemplate*{block begin}{uha}{
  \par\vskip\medskipamount%
  \usebeamercolor{block title}
  \ifx\insertblocktitle\@empty\newcommand{\yskiplength}{1.5ex}
  \else\newcommand{\yskiplength}{2.5ex}
  \fi
  \begin{tikzpicture}
    \node [
      draw=fg,
  	  fill=bg,
  	  text=fg,
      inner sep = 6pt,
      inner ysep = \yskiplength,
      text width=\textwidth - 6ex,
      minimum width=\textwidth - 6ex,
      align=justify,
	  rounded corners = 5pt,
	  drop shadow={top color=black!70!uha@bggray,
          bottom color= uha@bggray,
		  shadow xshift=3pt,
		  shadow yshift=-3pt,
		  rounded corners},
    ] (BOXCONTENT) \bgroup \noindent%
    \usebeamerfont{beamer body}%
    \usebeamercolor{block body}%
}

\defbeamertemplate*{block end}{uha}{
  \egroup;
  \usebeamercolor{block title}
  \ifx\insertblocktitle\@empty
  \else%
  {
    \node[
	  draw=fg,
      fill=fg,
      anchor=west,
      text=bg,
      rounded corners
  ] at ([shift={(4pt,0)}]BOXCONTENT.north west) {\textit{\insertblocktitle}};
  }
  \fi
  \end{tikzpicture}
  \vskip\smallskipamount
}
%--------------------------------------------------------------
% Title frame
%--------------------------------------------------------------
\defbeamertemplate*{title page}{uha}{
	\nointerlineskip%
	\vskip0pt%
	\begin{beamercolorbox}[dp=0ex, wd=\paperwidth, ht=0.2\paperheight, right, rightskip=5pt]{titlepage}
		\resizebox{!}{0.16\paperheight}{\input{logo/titlepage-logo-uha.tikz}}%
	\end{beamercolorbox}%
	\begin{beamercolorbox}[dp=0ex, wd=\paperwidth, ht=0.65\paperheight, left,leftskip=20pt]{titlepage}
		{\huge\bfseries \inserttitle}\strut\par
		\vskip2ex
		{\large \bfseries \insertsubtitle}\strut\par
		\vskip5pt
		\begin{tikzpicture}
			\draw[line width=0.5pt, rounded corners] (0,0) -- (0.85\linewidth,0);
		\end{tikzpicture}
		\vskip15pt
		{\bfseries\insertauthor}\strut\par
		\vskip1ex
		{\insertinstitute}\strut\par
		\vskip0.1\paperheight%
	\end{beamercolorbox}
	\begin{beamercolorbox}[dp=0ex, wd=\paperwidth, ht=0.15\paperheight, right, rightskip=20pt]{titlepage}
		{\small\insertdate}
		\vskip5pt
	\end{beamercolorbox}%
}

